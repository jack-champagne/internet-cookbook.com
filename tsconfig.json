{
  // Type-check the pure modules from their JSDoc; the code stays JavaScript.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    "skipLibCheck": true
  },
  "files": [
    "src/crease/geometry.js",
    "src/content/markdown.js",
    "src/content/units.js",
    "src/content/errors.js",
    "src/preflight.js",
    "src/html.js"
  ]
}
