{
  // Type-check the pure modules from their JSDoc; the code stays JavaScript.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "skipLibCheck": true
  },
  "files": ["public/crease/geometry.js", "public/recipe-md.js"]
}
